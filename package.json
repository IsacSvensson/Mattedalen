{
  "name": "multiplikation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Forskningsbaserat multiplikationsspel för barn 6–9 år (offline-PWA)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "licenses": "node scripts/third-party-licenses.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  }
}
